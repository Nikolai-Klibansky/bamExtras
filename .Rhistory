library(bamExtras)
# Chunk 3
bamStockMisc
nm_rdat <- paste0("rdat_",bamStockMisc$Name)
nm_rdat
# Chunk 1: setup
knitr::opts_chunk$set(echo = TRUE)
# Chunk 2
library(bamExtras)
# Chunk 3
nm_rdat <- paste0("rdat_",bamStockMisc$Name)
# Chunk 4
for(i in seq_along(nm_rdat)){
nm_i <- nm_rdat[i]
}
nm_i
# names of objects in rdat
rdat_names <- vector(mode="list",length=length(nm_rdat))
rdat_names
?vector
# names of objects in rdat
rdat_elements <- vector(mode="list",length=length(nm_rdat))
for(i in seq_along(nm_rdat)){
nm_rdat_i <- nm_rdat[i]
rdat_i <- get(nm_rdat_i)
rdat_elements[[i]] <- names(rdat_i)
}
Name_abb <- abbreviate(bamStockMisc$Name)
Name_abb
?abbreviate
Name_abb <- abbreviate(bamStockMisc$Name,minlength = 5)
nm_rdat <- paste0("rdat_",bamStockMisc$Name)
Name_abb
abbreviate(bamStockMisc$Name,minlength = 6)
# names of objects in rdat
rdat_elements <- vector(mode="list",length=length(nm_rdat))
names(rdat_elements) <- Name_abb
for(i in seq_along(nm_rdat)){
nm_rdat_i <- nm_rdat[i]
rdat_i <- get(nm_rdat_i)
rdat_elements[[i]] <- names(rdat_i)
}
rdat_elements
