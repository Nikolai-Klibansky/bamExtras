# spawn_time_frac: time of year (as fraction) for spawning
0.25 # spawn_time_frac

# set_q_DD_phase: Estimation phase of random walk on q (negative value turns it off)
-1 # set_q_DD_phase
# set_q_DD_beta: Density dependent catchability exponent, value of zero is density independent, est range is (0.1,0.9)
0 # set_q_DD_beta
# set_q_DD_beta_se: SE of density dependent catchability exponent (0.128 provides 95% CI in range 0.5)
0.128 # set_q_DD_beta_se
# set_q_DD_stage: Minimum age to use when computing B0_q_DD (should be age near full exploitation)
4 # set_q_DD_stage
# Estimation phase for random walk in catchability (negative value turns it off)
3 # set_q_RW_phase
# Variance (sd^2) of fishery dependent random walk catchabilities (0.03 is near the sd=0.17 of Wilberg and Bence)
0.03 # set_q_RW_var_cHL
0.03 # set_q_RW_var_rHB

